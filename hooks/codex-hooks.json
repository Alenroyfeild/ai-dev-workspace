{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -c \"import os,runpy; runpy.run_path(os.path.join(os.environ['CLAUDE_PLUGIN_ROOT'],'bin','ws-plugin'),run_name='__main__')\" --client codex",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -c \"import os,runpy; runpy.run_path(os.path.join(os.environ['CLAUDE_PLUGIN_ROOT'],'bin','ws-plugin'),run_name='__main__')\" --client codex",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
