{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/bin/ws-python\" \"${CLAUDE_PLUGIN_ROOT}/bin/ws-plugin\" --client claude",
            "timeout": 15
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/bin/ws-python\" \"${CLAUDE_PLUGIN_ROOT}/bin/ws-plugin\" --client claude",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/bin/ws-python\" \"${CLAUDE_PLUGIN_ROOT}/bin/ws-plugin\" --client claude",
            "timeout": 15
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/bin/ws-python\" \"${CLAUDE_PLUGIN_ROOT}/bin/ws-plugin\" --client claude",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
