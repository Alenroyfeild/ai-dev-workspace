{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 10,
            "command": "python3 {{OLD_KIT}}/bin/ws --workspace-root {{WORKSPACE}} brief --hook --client codex"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 10,
            "command": "python3 {{OLD_KIT}}/bin/ws --workspace-root {{WORKSPACE}} nudge --hook --client codex"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 10,
            "command": "python3 {{OLD_KIT}}/bin/ws --workspace-root {{WORKSPACE}} nudge --hook --client codex"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 10,
            "command": "python3 {{OLD_KIT}}/bin/ws --workspace-root {{WORKSPACE}} paste --hook --client codex"
          }
        ]
      }
    ]
  }
}
