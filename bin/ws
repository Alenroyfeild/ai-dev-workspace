#!/usr/bin/env python3
"""Entry point: put this repo's bin/ on PATH, or run python3 bin/ws."""
import sys
import os
from pathlib import Path
if os.name == 'nt':
    for stream in (sys.stdin, sys.stdout, sys.stderr): stream.reconfigure(encoding='utf-8')
kit = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(kit.parent if (kit / 'core.py').is_file() else kit))
from ws.cli import main
sys.exit(main())
