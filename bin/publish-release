#!/usr/bin/env bash
set -euo pipefail

tag=${1:?usage: publish-release TAG NOTES_FILE}
notes=${2:?usage: publish-release TAG NOTES_FILE}

update_draft() {
  if [ "$1" != true ]; then
    echo "Release $tag is already published or its draft state is unknown; refusing to edit." >&2
    return 1
  fi
  gh release edit "$tag" --notes-file "$notes"
}

if state=$(gh release view "$tag" --json isDraft --jq .isDraft 2>&1); then
  update_draft "$state"
  echo "Draft release $tag already exists; updated notes."
  exit 0
fi

case "$state" in
  *"HTTP 404:"*|*"release not found"*) ;;
  *) echo "Could not check release $tag; refusing to create: $state" >&2; exit 1 ;;
esac

set +e
create_error=$(gh release create "$tag" --title "$tag" --notes-file "$notes" --draft 2>&1)
create_status=$?
set -e
if [ "$create_status" -eq 0 ]; then
  [ -z "$create_error" ] || echo "$create_error"
  exit 0
fi

if state=$(gh release view "$tag" --json isDraft --jq .isDraft 2>/dev/null); then
  update_draft "$state"
  echo "Draft release $tag appeared during creation; updated notes."
  exit 0
fi

echo "$create_error" >&2
exit "$create_status"
