#!/usr/bin/env python3
"""Normalize generated sdist archive metadata for repeatable release hashes."""
import argparse
import copy
import gzip
import os
import tarfile
import tempfile
from pathlib import Path


def normalize(path, epoch):
    path = Path(path)
    if epoch < 0:
        raise ValueError('epoch must be nonnegative')
    fd, temp = tempfile.mkstemp(prefix='.sdist-', dir=str(path.parent))
    try:
        with os.fdopen(fd, 'wb') as output, tarfile.open(path, 'r:gz') as source:
            with gzip.GzipFile(filename='', fileobj=output, mode='wb', mtime=0) as zipped:
                with tarfile.open(fileobj=zipped, mode='w', format=tarfile.PAX_FORMAT) as dest:
                    for member in sorted(source.getmembers(), key=lambda item: item.name):
                        normalized = copy.copy(member)
                        normalized.mtime = epoch
                        normalized.uid = normalized.gid = 0
                        normalized.uname = normalized.gname = ''
                        normalized.pax_headers = {}
                        contents = source.extractfile(member) if member.isfile() else None
                        try:
                            dest.addfile(normalized, contents)
                        finally:
                            if contents is not None:
                                contents.close()
        os.replace(temp, path)
    finally:
        if os.path.exists(temp):
            os.unlink(temp)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('archive', type=Path)
    parser.add_argument('epoch', type=int)
    args = parser.parse_args()
    normalize(args.archive, args.epoch)


if __name__ == '__main__':
    main()
