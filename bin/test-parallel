#!/usr/bin/env python3
"""Run tests/test_*.py in parallel unittest processes (stdlib only); exit nonzero if any shard fails.

Usage: bin/test-parallel [-j N] [-v]. Each module runs in its own process (slowest first), so tests keep
the process isolation they assume; output of a failing module is printed in full.
"""
import argparse, os, re, subprocess, sys, time
from concurrent.futures import ThreadPoolExecutor
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent


def run(module, verbose):
    start = time.monotonic()
    cmd = [sys.executable, '-m', 'unittest'] + (['-v'] if verbose else []) + [module]
    env = dict(os.environ, PYTHONPATH=os.pathsep.join(filter(None, [str(ROOT), os.environ.get('PYTHONPATH', '')])))
    proc = subprocess.run(cmd, cwd=ROOT / 'tests', env=env, capture_output=True, text=True,
                          encoding='utf-8', errors='replace')
    code = 0 if proc.returncode == 5 else proc.returncode  # 5 = no tests in a helper module (Python 3.12+); discover treats that as fine
    return module, code, proc.stdout + proc.stderr, time.monotonic() - start


def main():
    p = argparse.ArgumentParser(description=__doc__)
    p.add_argument('-j', type=int, default=max(2, (os.cpu_count() or 2)))
    p.add_argument('-v', action='store_true')
    args = p.parse_args()
    files = sorted((ROOT / 'tests').glob('test*.py'), key=lambda f: -f.stat().st_size)  # big modules first
    modules = [f.stem for f in files]
    failed, total, ran = [], time.monotonic(), 0
    with ThreadPoolExecutor(max_workers=args.j) as pool:
        for module, code, output, seconds in pool.map(lambda m: run(m, args.v), modules):
            tail = output.strip().splitlines()[-1:] or ['']
            ran += sum(int(n) for n in re.findall(r'^Ran (\d+) tests?', output, re.M))
            print(f'{module}: {"ok" if code == 0 else "FAILED"} ({seconds:.1f}s) {tail[0]}', flush=True)
            if code:
                failed.append(module); print(output, flush=True)
    print(f'Ran {ran} tests in {len(modules)} modules, {len(failed)} failed, {time.monotonic() - total:.0f}s with -j {args.j}')
    if failed:
        print('FAILED: ' + ' '.join(failed)); return 1
    return 0


if __name__ == '__main__':
    sys.exit(main())
